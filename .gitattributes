# Auto detect text files and perform LF normalization
* text=auto

# Keep Windows-specific files as CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Prevent binary files (images/favicons) from being corrupted
*.png binary
*.jpg binary
*.ico binary
*.webp binary
*.gif binary

# Prevent local environment and database files from being exported in archives (e.g. GitHub ZIP downloads)
.env* export-ignore
data/database.json export-ignore
.next/ export-ignore
node_modules/ export-ignore

# Avoid merge conflicts or accidental tracking/overwriting of local configs/databases
.env.local merge=ours
data/database.json merge=ours

